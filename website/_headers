# Response headers for Cloudflare (Workers static assets and Pages both read this file).
# Security headers on every page; fonts are cached for a year, the stylesheet and script for a week (pages load them with a ?v= version).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/site.css
  Cache-Control: public, max-age=604800

/site.js
  Cache-Control: public, max-age=604800
