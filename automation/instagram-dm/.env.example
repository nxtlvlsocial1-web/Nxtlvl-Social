# From the Meta app dashboard: Instagram > API setup with Instagram login > Business login settings
IG_APP_ID=
IG_APP_SECRET=

# Any long random string. Paste the same value into the webhook "Verify token" field in the Meta dashboard.
WEBHOOK_VERIFY_TOKEN=

# Must match a "Valid OAuth redirect URI" in the Meta dashboard exactly.
IG_REDIRECT_URI=https://dm.example.com/oauth/callback

# Protects /admin/*. Any long random string.
ADMIN_TOKEN=

# Optional
# PUBLIC_URL=https://dm.example.com      (defaults to the origin of IG_REDIRECT_URI)
# GRAPH_API_VERSION=v23.0
# RULES_DIR=../../brands
# DATA_FILE=data/store.json               (holds access tokens; keep it private and backed up)
# HUMAN_TAKEOVER_HOURS=12
# PORT=3000
