{
 "duration": 48.348,
 "lines": [
  {
   "line": 1,
   "text": "The scariest phone call in America came from inside the house.",
   "start": 0.12,
   "end": 3.918
  },
  {
   "line": 2,
   "text": "I was babysitting two kids. They were asleep upstairs by eight.",
   "start": 4.318,
   "end": 7.928
  },
  {
   "line": 3,
   "text": "At nine, the house phone rang. A man laughed, and hung up.",
   "start": 8.278,
   "end": 11.705
  },
  {
   "line": 4,
   "text": "At ten, it rang again. He whispered,",
   "start": 12.155,
   "end": 14.328
  },
  {
   "line": 5,
   "text": "Have you checked the children?",
   "start": 14.628,
   "end": 16.52
  },
  {
   "line": 6,
   "text": "I called the police. They said, if he calls again, keep him on the line. We'll trace it.",
   "start": 17.12,
   "end": 21.916
  },
  {
   "line": 7,
   "text": "He called again.",
   "start": 22.316,
   "end": 23.442
  },
  {
   "line": 8,
   "text": "Have you checked the children?",
   "start": 23.792,
   "end": 25.901
  },
  {
   "line": 9,
   "text": "I kept him talking for a whole minute.",
   "start": 26.451,
   "end": 28.299
  },
  {
   "line": 10,
   "text": "Then my cell phone buzzed. It was the police.",
   "start": 28.799,
   "end": 31.398
  },
  {
   "line": 11,
   "text": "Get out of the house. Now. The calls are coming from inside the house.",
   "start": 31.698,
   "end": 35.095
  },
  {
   "line": 12,
   "text": "From the phone upstairs.",
   "start": 35.345,
   "end": 36.719
  },
  {
   "line": 13,
   "text": "I looked up the stairs.",
   "start": 37.169,
   "end": 38.474
  },
  {
   "line": 14,
   "text": "Someone was standing at the top. Still holding the phone.",
   "start": 38.974,
   "end": 42.328
  },
  {
   "line": 15,
   "text": "Have you checked the children?",
   "start": 42.928,
   "end": 45.348
  }
 ]
}