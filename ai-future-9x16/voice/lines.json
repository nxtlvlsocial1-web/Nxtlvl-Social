   "end": 62.075
  },
  {
   "line": 11,
   "take": "11",
   "speaker": "alex",
   "text": "Turn around! The bridge is going down!",
   "start": 62.595,
   "end": 64.905
  },
  {
   "line": 12,
   "take": "12",
   "speaker": "driver",
   "text": "How did you know?",
   "start": 72.525,
   "end": 74.205
  },
  {
   "line": 13,
   "take": "13",
   "speaker": "alex",
   "text": "A message... from me?",
