   "text": "$2,000,000! How?!",
   "start": 42.9,
   "end": 45.86
  },
  {
   "line": 8,
   "take": "08",
   "speaker": "alex",
   "text": "Lucky guess.",
   "start": 46.58,
   "end": 48.525
  },
  {
   "line": 9,
   "take": "09",
   "speaker": "phone",
   "text": "Tomorrow. 12 PM. The bridge collapses. 14 cars on it.",
   "start": 52.145,
   "end": 57.985
  },
  {
   "line": 10,
   "take": "10",
   "speaker": "driver",
   "text": "Get out of the road, man!",
