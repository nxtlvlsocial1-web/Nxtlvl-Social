   "speaker": "phone",
   "text": "Tomorrow. 9:14 AM. The man in the grey coat drops his coffee.",
   "start": 3.4,
   "end": 9.405
  },
  {
   "line": 2,
   "take": "02",
   "speaker": "alex",
   "text": "Tomorrow? That's not possible.",
   "start": 10.225,
   "end": 12.605
  },
  {
   "line": 3,
   "take": "03",
   "speaker": "alex",
   "text": "It's real.",
   "start": 20.225,
   "end": 22.37
  },
  {
   "line": 4,
   "take": "04",
   "speaker": "jay",
   "text": "Bro, you put everything on one number?!",
