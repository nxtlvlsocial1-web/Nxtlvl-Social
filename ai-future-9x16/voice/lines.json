   "speaker": "phone",
   "text": "Tomorrow. 9:14 AM. The man in the grey coat drops his coffee.",
   "start": 2.4,
   "end": 8.405
  },
  {
   "line": 2,
   "take": "02",
   "speaker": "alex",
   "text": "Tomorrow? That's not possible.",
   "start": 8.625,
   "end": 11.005
  },
  {
   "line": 3,
   "take": "03",
   "speaker": "alex",
   "text": "It's real.",
   "start": 13.825,
   "end": 15.97
  },
  {
   "line": 4,
   "take": "04",
   "speaker": "jay",
   "text": "Bro, you put everything on one number?!",
   "start": 16.89,
   "end": 19.66
  },
  {
   "line": 5,
   "take": "05",
   "speaker": "alex",
   "text": "Black 17. Trust me.",
