   "end": 22.13
  },
  {
   "line": 6,
   "take": "06",
   "speaker": "dealer",
   "text": "No more bets.",
   "start": 22.7,
   "end": 25.08
  },
  {
   "line": 7,
   "take": "07",
   "speaker": "jay",
   "text": "$2,000,000! How?!",
   "start": 27.5,
   "end": 30.46
  },
  {
   "line": 8,
   "take": "08",
   "speaker": "alex",
   "text": "Lucky guess.",
   "start": 30.98,
   "end": 32.925
  },
  {
   "line": 9,
   "take": "09",
   "speaker": "phone",
   "text": "Tomorrow. 12 PM. The bridge collapses. 14 cars on it.",
   "start": 33.945,
   "end": 39.785
  },
  {
   "line": 10,
   "take": "10",
   "speaker": "driver",
   "text": "Get out of the road, man!",
   "start": 40.905,
   "end": 42.375
  },
  {
   "line": 11,
   "take": "11",
   "speaker": "alex",
   "text": "Turn around! The bridge is going down!",
   "start": 42.795,
   "end": 45.105
  },
  {
   "line": 12,
   "take": "12",
   "speaker": "driver",
   "text": "How did you know?",
   "start": 48.125,
   "end": 49.805
  },
  {
   "line": 13,
   "take": "13",
   "speaker": "alex",
   "text": "A message... from me?",
   "start": 50.925,
   "end": 53.25
  },
  {
   "line": 14,
   "take": "14",
   "speaker": "jay",
   "text": "Alex? It's me. Open the door.",
   "start": 54.77,
   "end": 57.2
  },
  {
   "line": 15,
   "take": "15",
   "speaker": "alex",
   "text": "Show me tomorrow.",
   "start": 59.82,
   "end": 61.08
  },
  {
   "line": 16,
   "take": "16",
   "speaker": "phone",
   "text": "There is no tomorrow.",
   "start": 61.8,
   "end": 63.99
  },
  {
   "line": 17,
   "take": "17",
   "speaker": "phone",
